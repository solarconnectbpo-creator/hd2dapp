{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --prefix roofing-estimator-vite --no-audit --no-fund",
  "buildCommand": "npm run build --prefix roofing-estimator-vite",
  "outputDirectory": "roofing-estimator-vite/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
